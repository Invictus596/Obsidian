{
  "manifest_version": 3,
  "name": "Obsidian Test Ext",
  "version": "1.0",
  "description": "Dummy extension to test the Obsidian extension loader pipeline.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": []
}
